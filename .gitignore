# ── 密钥 ──────────────────────────────────────────────
# 凭据只从环境变量读，任何 .env 都不入库
.env
.env.local
*.key
*.pem

# ── 真实数据（本地资产，不入库）──────────────────────
# DuckDB 单文件与备份、冷存 parquet、导出的扫描快照
workbench/data/
*.duckdb
*.duckdb.wal
*.duckdb.bak-*
*.parquet

# ── 本机运行时配置（设置页写入，含本机 endpoint/模型偏好）────
# settings.yaml 是入库的默认值；settings.local.yaml 由 /api/settings 覆盖写入，
# 属于本机偏好，不入库。密钥始终只走 WORKBENCH_AI_API_KEY，两个文件都不存明文。
workbench/config/settings.local.yaml

# ── 外部 GPL 源码（vendor）────────────────────────────
# TrendRadar 是 GPL-3.0，原样保留在 vendor/ 且自带 .git。
# 不纳入本仓库：避免嵌套 repo，也避免把 GPL 代码复制进我们的版本历史。
# 重新获取：git clone https://github.com/sansan0/TrendRadar workbench/vendor/TrendRadar
# 加载方式见 engine/news_trendradar.py（单文件 importlib，不 import 包）
workbench/vendor/

# ── 测试与运行产物 ────────────────────────────────────
# 本机系统 Temp 权限被拒，pytest 用项目内 --basetemp，每轮一个新目录
.pytest-tmp*/
.pytest_cache/
__pycache__/
*.pyc
*.pyo
# 浏览器自动化临时快照
.playwright-cli/
# 浏览器验收截图产物
workbench/output/

# 一次性诊断脚本与手工构造的请求样本（排障用，用完即弃，不入库）
.tmp_*

# Node 依赖（pi_agent 走 package-lock.json 复原）
node_modules/

# 浏览器验收的临时演示实例（含副本库与截图）
.ui-demo-*/
.ui-check-*.png

# 验收用的数据库副本与临时启动器。验收必须跑在副本上，
# 真实库只读；这个目录里的东西用完即弃，不入库。
.acceptance/

# 服务日志
*.log

# 收盘流水线导出的单次运行结果
workbench/pipeline_*.json

# 训练产物
workbench/data/models/
out/

# ── 环境 ──────────────────────────────────────────────
.venv/
venv/


# ── 个人开发流水账（不入公开仓库）───────────────
# 历史实施计划/设计文档、主题截图、踩坑记录、开发进度，公开仓库不需要。
workbench/docs/superpowers/
docs/superpowers/
docs/theme_shots/
.learnings/
findings.md
lessons.md
progress.md
task_plan.md
